{
  "name": "local-forwarder",
  "version": "0.1.0",
  "description": "A local HTTP, HTTPS, and TZT forwarding service",
  "author": "Local Forwarder",
  "private": true,
  "scripts": {
    "dev": "tauri dev",
    "dev:renderer": "vite --config vite.config.ts",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "package:mac": "tauri build",
    "package:release:mac": "tauri build && node scripts/generate-update-manifest.mjs && node scripts/verify-release-assets.mjs mac",
    "verify:release:tag": "node scripts/verify-release-tag.mjs",
    "verify:release:mac": "node scripts/verify-release-assets.mjs mac"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "antd": "^6.6.5",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}
